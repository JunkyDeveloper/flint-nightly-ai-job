# Copy to .env on the server: cp .env.example .env && chmod 600 .env
# Never commit .env (it is in .gitignore).

# --- Secrets ---------------------------------------------------------------
# Claude Pro token: run `claude setup-token` on a machine with a browser, paste the printed token.
CLAUDE_CODE_OAUTH_TOKEN=
# GitHub fine-grained PAT, repository JunkyDeveloper/FlintBenchmark only,
# permissions: Contents = Read and write, Pull requests = Read and write.
GITHUB_TOKEN=

# --- Commit identity (your name + email) ------------------------------------
GIT_AUTHOR_NAME="JunkyDeveloper"
GIT_AUTHOR_EMAIL="junkydeveloper@gmail.com"
GIT_COMMITTER_NAME="JunkyDeveloper"
GIT_COMMITTER_EMAIL="junkydeveloper@gmail.com"

# --- Paths / time -------------------------------------------------------------
# Your timezone; the runner's deadline and report dates use it.
TZ=Europe/Berlin

# --- Limits (defaults shown) -------------------------------------------------
MAX_SUBJECTS_PER_NIGHT=3
# Local time after which no new subject starts and running work is stopped.
DEADLINE=08:15
SUBJECT_TIMEOUT_MIN=90
MAX_ROUNDS=10

# --- Models -------------------------------------------------------------------
PLAN_MODEL=opus
EXEC_MODEL=sonnet
SUPERVISOR_MODEL=haiku

# --- Target --------------------------------------------------------------------
FLINT_REPO=JunkyDeveloper/FlintBenchmark
BASE_BRANCH=master
PREFLIGHT_TEST=tests/connectible/iron_bars_connections.json
